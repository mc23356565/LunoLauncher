<Window x:Class="OpenLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LunoLauncher" Width="980" Height="620" MinWidth="840" MinHeight="540"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg}"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Text}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" Icon="Assets/icon.png"
        StateChanged="Window_StateChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 自定义背景图 -->
        <Image x:Name="BgImage" Grid.Row="1" Stretch="UniformToFill" Opacity="0.28" IsHitTestVisible="False"/>

        <!-- 标题栏 -->
        <Border Background="{DynamicResource TitleBrush}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Source="Assets/icon.png" Width="26" Height="26" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <TextBlock Text="LunoLauncher" Foreground="{DynamicResource Text}" FontSize="15.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="9,0,0,1"/>
                    <Border Background="{DynamicResource AccentSoft}" CornerRadius="6" Padding="6,1" Margin="8,2,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionTag" Text="v0.1" Foreground="{DynamicResource Accent}" FontSize="10.5"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <RadioButton x:Name="NavLaunch" GroupName="nav" Style="{StaticResource TopNav}" Tag="&#xE768;" Content="启动" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavDownload" GroupName="nav" Style="{StaticResource TopNav}" Tag="&#xE896;" Content="下载" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavCoop" GroupName="nav" Style="{StaticResource TopNav}" Tag="&#xE716;" Content="联机" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavSettings" GroupName="nav" Style="{StaticResource TopNav}" Tag="&#xE713;" Content="设置" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavMore" GroupName="nav" Style="{StaticResource TopNav}" Tag="&#xE712;" Content="更多" Checked="Nav_Checked"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="TasksButton" Style="{StaticResource TitleIcon}" Width="Auto" Padding="0" Click="Tasks_Click" ToolTip="任务列表">
                        <Border Padding="10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TaskCount" Text="" FontFamily="{StaticResource UiFont}" FontSize="12" Margin="6,0,0,1" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Button>
                    <Button Style="{StaticResource TitleIcon}" Content="&#xE921;" Click="Min_Click" ToolTip="最小化"/>
                    <Button x:Name="MaxButton" Style="{StaticResource TitleIcon}" Content="&#xE922;" Click="Max_Click" ToolTip="最大化"/>
                    <Button Style="{StaticResource TitleIcon}" Content="&#xE8BB;" Click="Close_Click" ToolTip="关闭"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 页面 -->
        <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False"/>

        <!-- 任务抽屉 -->
        <Grid x:Name="TaskLayer" Grid.Row="1" Visibility="Collapsed">
            <Border Background="#22101828" MouseDown="TaskLayer_MouseDown"/>
            <Border HorizontalAlignment="Right" Width="360" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="18,14,12,8">
                        <TextBlock Text="任务" Style="{StaticResource H1}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource Ghost}" Content="清除已完成" Click="ClearTasks_Click"/>
                            <Button Style="{StaticResource Ghost}" Click="Tasks_Click" ToolTip="关闭">
                                <TextBlock Text="&#xE8BB;" Style="{StaticResource Icon}" FontSize="11"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <TextBlock x:Name="NoTasks" Text="暂时没有任务" Style="{StaticResource Sub}" HorizontalAlignment="Center" Margin="0,40,0,0"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="TaskList" Margin="14,0,14,14">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Bg}" CornerRadius="9" Padding="12,10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,70,0"/>
                                                    <TextBlock Text="{Binding StateText}" HorizontalAlignment="Right" Style="{StaticResource Sub}"/>
                                                </Grid>
                                                <ProgressBar Margin="0,8,0,6" Maximum="1" Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding Indeterminate, Mode=OneWay}"
                                                             Visibility="{Binding IsActive, Converter={StaticResource BoolVis}}"/>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Sub}" MaxHeight="120" Margin="0,2,0,0"/>
                                                <Grid Margin="0,4,0,0">
                                                    <TextBlock Style="{StaticResource Sub}">
                                                        <Run Text="{Binding ProgressText, Mode=OneWay}"/>
                                                        <Run Text="  "/>
                                                        <Run Text="{Binding SpeedText, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <Button Content="取消" Style="{StaticResource Ghost}" Padding="6,2" HorizontalAlignment="Right" Click="CancelTask_Click"
                                                            Visibility="{Binding IsActive, Converter={StaticResource BoolVis}}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 底部提示 -->
        <Border x:Name="ToastBox" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,26"
                Background="#EE1F2633" CornerRadius="18" Padding="18,9" Visibility="Collapsed" IsHitTestVisible="False" MaxWidth="600">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ToastIcon" Text="&#xE946;" FontFamily="{StaticResource Icons}" Foreground="White" VerticalAlignment="Center" Margin="0,1,9,0"/>
                <TextBlock x:Name="ToastText" Foreground="White" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 对话框层 -->
        <Grid x:Name="DialogLayer" Grid.RowSpan="2" Visibility="Collapsed" Background="#73101828">
            <ContentControl x:Name="DialogHost" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False"/>
        </Grid>
    </Grid>
</Window>
