<UserControl x:Class="OpenLauncher.UI.Pages.GameInstallPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,16,22,16" MaxWidth="760" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Style="{StaticResource Ghost}" Click="Back_Click" Margin="-8,0,6,0">
                    <TextBlock Text="&#xE72B;" Style="{StaticResource Icon}"/>
                </Button>
                <TextBlock x:Name="Header" Text="安装" Style="{StaticResource H1}" VerticalAlignment="Center"/>
            </StackPanel>

            <Border Style="{StaticResource CardBox}">
                <StackPanel>
                    <TextBlock Text="选择加载器" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Sub}" Text="想装 Mod 选一个加载器；只想玩原版就选“原版”。Mod 下载页会按你选的加载器筛选。" Margin="0,0,0,10"/>
                    <WrapPanel>
                        <RadioButton x:Name="LNone" GroupName="ld" Style="{StaticResource Pill}" Content="原版" IsChecked="True" Checked="Loader_Checked"/>
                        <RadioButton x:Name="LFabric" GroupName="ld" Style="{StaticResource Pill}" Content="Fabric" Checked="Loader_Checked"/>
                        <RadioButton x:Name="LForge" GroupName="ld" Style="{StaticResource Pill}" Content="Forge" Checked="Loader_Checked"/>
                        <RadioButton x:Name="LNeo" GroupName="ld" Style="{StaticResource Pill}" Content="NeoForge" Checked="Loader_Checked"/>
                        <RadioButton x:Name="LQuilt" GroupName="ld" Style="{StaticResource Pill}" Content="Quilt" Checked="Loader_Checked"/>
                    </WrapPanel>
                    <Grid x:Name="LoaderRow" Margin="0,8,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="LoaderLabel" Text="版本" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="LoaderStatus" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="LoaderVersions" Width="300" SelectionChanged="LoaderVersions_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Version}"/>
                                            <TextBlock Text="{Binding Tag}" Foreground="{DynamicResource Accent}" FontSize="11" Margin="8,1,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="WithApi" Style="{StaticResource Switch}" Margin="0,12,0,0" Visibility="Collapsed" IsChecked="True"
                              Content="同时安装 Fabric API（绝大多数 Fabric Mod 都需要它）"/>
                    <Grid x:Name="OptiFineRow" Margin="0,12,0,0">
                        <CheckBox x:Name="WithOptiFine" Style="{StaticResource Switch}" Content="同时安装 OptiFine（高清修复 / 光影）" Click="WithOptiFine_Click" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="OptiFineStatus" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="OptiFineVersions" Width="300" Visibility="Collapsed" SelectionChanged="LoaderVersions_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Version}"/>
                                            <TextBlock Text="{Binding Tag}" Foreground="{DynamicResource Text3}" FontSize="11" Margin="8,1,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBox}">
                <StackPanel>
                    <TextBlock Text="版本名" Style="{StaticResource H2}"/>
                    <TextBox x:Name="NameBox"/>
                    <TextBlock x:Name="NameHint" Style="{StaticResource Sub}" Margin="0,6,0,0"
                               Text="会在 versions 文件夹里创建同名文件夹。装了加载器的版本默认开启版本隔离，Mod 和存档互不干扰。"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="TargetText" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button x:Name="InstallButton" Content="开始安装" Style="{StaticResource Primary}" Padding="26,9" FontSize="14" Click="Install_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
