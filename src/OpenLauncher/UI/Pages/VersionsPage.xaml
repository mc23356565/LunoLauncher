<UserControl x:Class="OpenLauncher.UI.Pages.VersionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="22,16,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" Grid.ColumnSpan="3" Margin="0,0,0,12">
            <Button Style="{StaticResource Ghost}" Click="Back_Click" Margin="-8,0,6,0">
                <TextBlock Text="&#xE72B;" Style="{StaticResource Icon}"/>
            </Button>
            <TextBlock Text="版本选择" Style="{StaticResource H1}" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 游戏目录 -->
        <DockPanel Grid.Row="1">
            <TextBlock DockPanel.Dock="Top" Text="游戏目录" Style="{StaticResource Sub}" Margin="2,0,0,6"/>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button Content="添加已有的游戏目录" Click="AddFolder_Click" Margin="0,0,0,6"/>
                <Button Content="新建空的游戏目录" Style="{StaticResource Ghost}" Click="NewFolder_Click"/>
            </StackPanel>
            <ListBox x:Name="Folders" Style="{StaticResource CardList}" SelectionChanged="Folders_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Path}" Style="{StaticResource Sub}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="打开文件夹" Click="OpenFolder_Click"/>
                        <MenuItem Header="重命名" Click="RenameFolder_Click"/>
                        <MenuItem Header="从列表移除（不删除文件）" Click="RemoveFolder_Click"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
        </DockPanel>

        <!-- 版本列表 -->
        <DockPanel Grid.Row="1" Grid.Column="2">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBox x:Name="Search" Tag="搜索版本" TextChanged="Search_TextChanged" Margin="0,0,190,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="刷新" Click="Refresh_Click" Margin="0,0,8,0"/>
                    <Button Content="导入整合包" Click="ImportPack_Click" Style="{StaticResource Primary}"/>
                </StackPanel>
            </Grid>
            <Grid>
                <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="这个目录里还没有版本" Style="{StaticResource H2}" HorizontalAlignment="Center"/>
                    <Button Content="去下载一个" Style="{StaticResource Primary}" HorizontalAlignment="Center" Margin="0,8,0,0" Click="GoDownload_Click"/>
                </StackPanel>
                <ListBox x:Name="Versions" Style="{StaticResource CardList}" MouseDoubleClick="Versions_DoubleClick" VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="8" Background="{Binding Badge}" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding BadgeText}" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Id}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Desc}" Style="{StaticResource Sub}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource Ghost}" ToolTip="启动" Click="LaunchItem_Click">
                                        <TextBlock Text="&#xE768;" Style="{StaticResource Icon}"/>
                                    </Button>
                                    <Button Style="{StaticResource Ghost}" ToolTip="版本设置" Click="SettingsItem_Click">
                                        <TextBlock Text="&#xE713;" Style="{StaticResource Icon}"/>
                                    </Button>
                                    <Button Style="{StaticResource Ghost}" ToolTip="打开文件夹" Click="FolderItem_Click">
                                        <TextBlock Text="&#xE838;" Style="{StaticResource Icon}"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
