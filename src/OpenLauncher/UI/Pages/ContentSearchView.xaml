<UserControl x:Class="OpenLauncher.UI.Pages.ContentSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:OpenLauncher.UI">
    <DockPanel Margin="22,18,22,10">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock x:Name="Header" Text="Mod" Style="{StaticResource H1}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <RadioButton x:Name="SrcModrinth" GroupName="src" Style="{StaticResource Pill}" Content="Modrinth" Margin="0,0,6,0" Checked="Source_Checked"/>
                <RadioButton x:Name="SrcCurse" GroupName="src" Style="{StaticResource Pill}" Content="CurseForge" Margin="0" Checked="Source_Checked"/>
            </StackPanel>
        </Grid>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Query" Tag="搜索（支持常见中文名，如：钠、机械动力、JEI）" KeyDown="Query_KeyDown"/>
            <Button Grid.Column="1" Content="搜索" Style="{StaticResource Primary}" Margin="8,0,0,0" Click="Search_Click"/>
        </Grid>

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                <TextBlock Text="版本" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="GameVersion" Width="120" SelectionChanged="Filter_Changed"/>
            </StackPanel>
            <StackPanel x:Name="LoaderPanel" Orientation="Horizontal" Margin="0,0,14,6">
                <TextBlock Text="加载器" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="Loader" Width="110" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="全部" Tag=""/>
                    <ComboBoxItem Content="Fabric" Tag="fabric"/>
                    <ComboBoxItem Content="Forge" Tag="forge"/>
                    <ComboBoxItem Content="NeoForge" Tag="neoforge"/>
                    <ComboBoxItem Content="Quilt" Tag="quilt"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                <TextBlock Text="排序" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="Sort" Width="110" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="相关度" Tag="relevance"/>
                    <ComboBoxItem Content="下载量" Tag="downloads"/>
                    <ComboBoxItem Content="最近更新" Tag="updated"/>
                    <ComboBoxItem Content="最新发布" Tag="newest"/>
                </ComboBox>
            </StackPanel>
            <StackPanel x:Name="TargetPanel" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="安装到" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="Target" Width="200" SelectionChanged="Target_Changed"/>
            </StackPanel>
        </WrapPanel>

        <Grid>
            <ListBox x:Name="Results" Style="{StaticResource CardList}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                     ScrollViewer.ScrollChanged="Results_ScrollChanged" MouseUp="Results_MouseUp">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="46" Height="46" CornerRadius="9" Background="{DynamicResource AccentSoft}" Margin="0,0,12,0" ClipToBounds="True" VerticalAlignment="Top">
                                <Image ui:RemoteImage.Url="{Binding IconUrl}" Stretch="UniformToFill"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Author}" Style="{StaticResource Sub}" Margin="8,2,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Sub}" Foreground="{DynamicResource Text2}" TextTrimming="CharacterEllipsis" MaxHeight="34" Margin="0,2,0,3"/>
                                <TextBlock Style="{StaticResource Sub}">
                                    <Run Text="{Binding SourceText, Mode=OneWay}"/>
                                    <Run Text=" · 下载 "/>
                                    <Run Text="{Binding DownloadsText, Mode=OneWay}"/>
                                    <Run Text=" · 更新于 "/>
                                    <Run Text="{Binding Updated, Mode=OneWay, StringFormat=yyyy-MM-dd}"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="StatusPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="StatusText" Style="{StaticResource Body}" HorizontalAlignment="Center" TextAlignment="Center"/>
                <ProgressBar x:Name="StatusBar" IsIndeterminate="True" Width="200" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
