<UserControl x:Class="OpenLauncher.UI.Pages.CoopPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,18,22,10" MaxWidth="900">

            <!-- 还没有房间时的引导 -->
            <Border x:Name="EmptyCard" Style="{StaticResource CardBox}">
                <StackPanel>
                    <TextBlock Text="一起玩" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Text="创建房间后把邀请信息发给朋友，对方粘贴就能进来。隧道会在后台自动建立，你不用关心虚拟网卡和节点。"/>
                    <WrapPanel Margin="0,14,0,0">
                        <Button Content="创建房间" Style="{StaticResource Primary}" Margin="0,0,8,0" Click="Create_Click"/>
                        <Button Content="加入房间" Margin="0,0,8,0" Click="Join_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- 当前房间 -->
            <Border x:Name="RoomCard" Style="{StaticResource CardBox}" Visibility="Collapsed">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="RoomTitle" Text="房间" Style="{StaticResource H2}"/>
                            <TextBlock x:Name="RoomSub" Style="{StaticResource Sub}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="关闭房间" Style="{StaticResource DangerButton}"
                                VerticalAlignment="Top" Click="CloseRoom_Click"/>
                    </Grid>

                    <Border Background="{DynamicResource CardHover}" CornerRadius="10" Padding="14,12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock x:Name="TunnelState" Style="{StaticResource Body}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="AddrLine" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock x:Name="ElevHint" Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="TunnelStartButton" Content="启动隧道" Style="{StaticResource Primary}"
                                        Margin="0,0,8,0" Click="StartTunnel_Click"/>
                                <Button x:Name="TunnelStopButton" Content="停止隧道"
                                        Margin="0,0,8,0" Click="StopTunnel_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="房间成员" Style="{StaticResource Body}" Margin="0,16,0,4"/>
                    <ListBox x:Name="PeerList" Style="{StaticResource CardList}" MaxHeight="180" MinHeight="52"/>
                    <TextBlock x:Name="PeerHint" Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,6,0,0"/>

                    <WrapPanel Margin="0,14,0,0">
                        <Button x:Name="LaunchButton" Content="启动游戏" Style="{StaticResource Primary}" Margin="0,0,8,8" Click="Launch_Click"/>
                        <Button x:Name="DetectButton" Content="读取端口" Margin="0,0,8,8" Click="Detect_Click"/>
                        <Button Content="复制邀请信息" Margin="0,0,8,8" Click="Invite_Click"/>
                        <Button Content="复制地址" Margin="0,0,8,8" Click="Copy_Click"/>
                        <Button Content="刷新成员" Margin="0,0,8,8" Click="RefreshPeers_Click"/>
                    </WrapPanel>
                    <WrapPanel>
                        <Button Content="房间设置" Margin="0,0,8,8" Click="Settings_Click"/>
                        <Button x:Name="ElevateButton" Content="以管理员身份重启" Margin="0,0,8,8" Click="Elevate_Click"/>
                        <Button Content="诊断" Margin="0,0,8,8" Click="Diagnose_Click"/>
                        <Button Content="状态与日志" Margin="0,0,8,8" Click="Report_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- 房间列表 -->
            <Border Style="{StaticResource CardBox}">
                <StackPanel>
                    <TextBlock Text="我的房间" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,2,0,10"
                               Text="每行保存的是一个房间的完整配置。双击进入房间。"/>
                    <ListBox x:Name="RoomList" Style="{StaticResource CardList}" MaxHeight="220" MinHeight="60"
                             MouseDoubleClick="RoomList_DoubleClick"/>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="进入选中房间" Style="{StaticResource Primary}" Margin="0,0,8,8" Click="Open_Click"/>
                        <Button Content="创建房间" Margin="0,0,8,8" Click="Create_Click"/>
                        <Button Content="加入房间" Margin="0,0,8,8" Click="Join_Click"/>
                        <Button Content="删除选中" Style="{StaticResource DangerButton}" Margin="0,0,8,8" Click="Remove_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
