<UserControl x:Class="OpenLauncher.UI.Pages.GameListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="22,18,22,14">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="安装 Minecraft" Style="{StaticResource H1}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBox x:Name="Search" Tag="搜索版本号" Width="200" TextChanged="Filter_Changed"/>
                <Button Content="刷新" Margin="8,0,0,0" Click="Refresh_Click"/>
            </StackPanel>
        </Grid>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <RadioButton x:Name="FRelease" GroupName="vt" Style="{StaticResource Pill}" Content="正式版" IsChecked="True" Checked="Filter_Changed"/>
            <RadioButton x:Name="FSnapshot" GroupName="vt" Style="{StaticResource Pill}" Content="快照版" Checked="Filter_Changed"/>
            <RadioButton x:Name="FOld" GroupName="vt" Style="{StaticResource Pill}" Content="远古版" Checked="Filter_Changed"/>
            <RadioButton x:Name="FFools" GroupName="vt" Style="{StaticResource Pill}" Content="愚人节版" Checked="Filter_Changed"/>
            <RadioButton x:Name="FAll" GroupName="vt" Style="{StaticResource Pill}" Content="全部" Checked="Filter_Changed"/>
        </WrapPanel>
        <Grid>
            <StackPanel x:Name="Loading" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="LoadingText" Text="正在从官方获取版本列表…" Style="{StaticResource Body}" HorizontalAlignment="Center"/>
                <ProgressBar IsIndeterminate="True" Width="220" Margin="0,10,0,0"/>
            </StackPanel>
            <ListBox x:Name="List" Style="{StaticResource CardList}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" MouseDoubleClick="List_DoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="7" Background="#4CAF50" Margin="0,0,12,0">
                                <TextBlock Text="MC" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Id}" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Style="{StaticResource Sub}">
                                    <Run Text="{Binding TypeText, Mode=OneWay}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding DateText, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="2" Content="安装" Style="{StaticResource Primary}" Padding="16,6" Click="Install_Click"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</UserControl>
