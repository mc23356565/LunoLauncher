<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>LunoLauncher</AssemblyName>
    <RootNamespace>LunoLauncher</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <Version>0.4.1</Version>
    <Product>LunoLauncher</Product>
    <Description>轻量的 Minecraft 启动器（OpenLauncher 分支）</Description>
    <Copyright>LunoLauncher contributors. Based on OpenLauncher, GPL-3.0.</Copyright>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>embedded</DebugType>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Security" />
    <Reference Include="Microsoft.VisualBasic" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.png" />
    <EmbeddedResource Include="Assets\zh-names.json" LogicalName="zh-names.json" />
  </ItemGroup>

  <!-- 联机：内置 EasyTier（官方 Release 的 Windows x64 包，原样打包，见 Assets\licenses） -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\tunnel\easytier-2.6.4-win64.zip" LogicalName="Luno.Payload.EasyTier.zip" />
    <EmbeddedResource Include="Assets\licenses\LGPL-3.0.txt" LogicalName="Luno.License.LGPL-3.0.txt" />
    <EmbeddedResource Include="Assets\licenses\wintun-license.txt" LogicalName="Luno.License.wintun.txt" />
    <EmbeddedResource Include="Assets\licenses\THIRD-PARTY.txt" LogicalName="Luno.License.THIRD-PARTY.txt" />
  </ItemGroup>

  <!--
    微软登录的 Client ID 不打进源码、也不进仓库。
    取值顺序：-p:MsClientId=xxx  →  仓库根的 clientid.txt（已 .gitignore）→ 空。
    取到的值写进 obj\BuiltInClientId.g.cs，编译成 Branding.DefaultMicrosoftClientId：
    官方发行版开箱就能登录；fork 出去的人必须自己申请一个。
  -->
  <PropertyGroup>
    <ClientIdFile>$(MSBuildProjectDirectory)\..\..\clientid.txt</ClientIdFile>
    <MsClientId Condition="'$(MsClientId)' == '' and Exists('$(ClientIdFile)')">$([System.IO.File]::ReadAllText('$(ClientIdFile)').Trim())</MsClientId>
    <!-- 以 Base64 存进程序集，避免 strings 直接扫到 GUID（不是加密，只挡自动化采集）。
         build.ps1 / CI 会算好 Base64 传进来；直接传 -p:MsClientId=明文 也能用（退化成明文存放）。 -->
    <MsClientIdEncoded Condition="'$(MsClientIdEncoded)' == ''">$(MsClientId)</MsClientIdEncoded>
  </PropertyGroup>

  <Target Name="GenerateBuiltInClientId" BeforeTargets="BeforeCompile">
    <WriteLinesToFile
      File="$(IntermediateOutputPath)BuiltInClientId.g.cs"
      Overwrite="true"
      WriteOnlyWhenDifferent="true"
      Lines="// auto-generated at build time: Microsoft Client ID, Base64 encoded (not in source control);namespace LunoLauncher;{;internal static class BuiltInClientId;{;public const string Encoded = &quot;$(MsClientIdEncoded)&quot;%3b;};}" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)BuiltInClientId.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)BuiltInClientId.g.cs" />
    </ItemGroup>
  </Target>
</Project>
