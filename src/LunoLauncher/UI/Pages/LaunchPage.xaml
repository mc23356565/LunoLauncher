<UserControl x:Class="LunoLauncher.UI.Pages.LaunchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左栏：账号 + 启动 -->
        <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="22,26,22,22">
                <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center">
                    <Border Width="84" Height="84" CornerRadius="14" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Center" ClipToBounds="True">
                        <Grid>
                            <TextBlock x:Name="AvatarFallback" Text="&#xE77B;" FontFamily="{StaticResource Icons}" FontSize="34" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="Avatar" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="PlayerName" Text="未登录" Style="{StaticResource H1}" HorizontalAlignment="Center" Margin="0,14,0,2" TextTrimming="CharacterEllipsis" MaxWidth="230"/>
                    <TextBlock x:Name="AccountType" Text="点击下方添加账号" Style="{StaticResource Sub}" HorizontalAlignment="Center"/>
                    <Button Style="{StaticResource Ghost}" Margin="0,8,0,0" HorizontalAlignment="Center" Click="Accounts_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8AB;" Style="{StaticResource Icon}" FontSize="12" Margin="0,1,6,0"/>
                            <TextBlock Text="切换 / 管理账号"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Button x:Name="LaunchButton" Style="{StaticResource Primary}" Height="68" Click="Launch_Click" Padding="0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="LaunchText" Text="启动游戏" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="White"/>
                            <TextBlock x:Name="LaunchSub" Text="未选择版本" FontSize="12" HorizontalAlignment="Center" Foreground="#DDFFFFFF" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                        </StackPanel>
                    </Button>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button Content="版本选择" Click="Versions_Click"/>
                        <Button Grid.Column="2" Content="版本设置" Click="VersionSettings_Click"/>
                    </Grid>
                </StackPanel>

                <!-- 启动进度 -->
                <StackPanel x:Name="LaunchProgressPanel" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="LaunchStep" Text="正在启动…" Style="{StaticResource Body}" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <ProgressBar x:Name="LaunchBar" Maximum="1" Margin="0,10,0,6"/>
                    <Button Content="取消启动" Style="{StaticResource Ghost}" HorizontalAlignment="Center" Click="CancelLaunch_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 右侧：主页内容 -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22,22,22,10">
                <!-- 游戏运行中 -->
                <Border x:Name="RunningCard" Style="{StaticResource CardBox}" Visibility="Collapsed">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="9" Height="9" Fill="{DynamicResource Ok}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" x:Name="RunningTitle" Text="游戏运行中" Style="{StaticResource H2}" Margin="0,0,12,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="打开游戏目录" Style="{StaticResource Ghost}" Click="OpenGameDir_Click"/>
                                <Button Content="结束游戏" Style="{StaticResource DangerButton}" Padding="12,5" Margin="6,0,0,0" Click="KillGame_Click"/>
                            </StackPanel>
                        </Grid>
                        <TextBox x:Name="GameLog" Margin="0,12,0,0" Height="190" IsReadOnly="True" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11.5"
                                 VerticalContentAlignment="Top" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#FAFBFD"/>
                    </StackPanel>
                </Border>

                <!-- 欢迎 -->
                <Border Style="{StaticResource CardBox}">
                    <StackPanel>
                        <TextBlock x:Name="Greeting" Text="欢迎回来" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Body}" Text="选择左边的版本，点“启动游戏”就能开玩。没有版本？去「下载」页装一个，原版、Forge、NeoForge、Fabric、Quilt 都能一键装。"/>
                        <WrapPanel Margin="0,14,0,0">
                            <Button x:Name="LatestRelease" Style="{StaticResource Primary}" Margin="0,0,10,8" Click="InstallLatest_Click" Visibility="Collapsed"/>
                            <Button x:Name="LatestSnapshot" Margin="0,0,10,8" Click="InstallLatest_Click" Visibility="Collapsed"/>
                            <Button Content="浏览全部版本" Style="{StaticResource Ghost}" Margin="0,0,0,8" Click="GoDownload_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 产品说明 -->
                <Border Style="{StaticResource CardBox}">
                    <StackPanel>
                        <TextBlock Text="为什么用它" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Body}">
                            <Run Text="• 游戏、加载器、Mod 直接从官方源下载，并逐个校验文件完整性；连不上时自动换用公益镜像。"/>
                            <LineBreak/>
                            <Run Text="• 版本列表实时从上游获取，启动器久未更新也能装到最新版本。"/>
                            <LineBreak/>
                            <Run Text="• 不收集任何数据，账号令牌用 Windows DPAPI 加密，只保存在你这台电脑上。"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- 当前版本摘要 -->
                <Border x:Name="InstanceCard" Style="{StaticResource CardBox}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="当前版本" Style="{StaticResource H2}"/>
                        <TextBlock x:Name="InstanceDesc" Style="{StaticResource Body}"/>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="打开游戏目录" Margin="0,0,8,6" Click="OpenGameDir_Click"/>
                            <Button Content="管理 Mod" Margin="0,0,8,6" Click="ManageMods_Click"/>
                            <Button Content="下载 Mod" Margin="0,0,8,6" Click="DownloadMods_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
